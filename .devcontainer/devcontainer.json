{
  "name": "CartSide Blitz",
  "image": "mcr.microsoft.com/devcontainers/javascript-node:1-22-bookworm",
  "forwardPorts": [8787],
  "portsAttributes": {
    "8787": {
      "label": "CartSide API",
      "onAutoForward": "notify"
    }
  },
  "postCreateCommand": "test -f .env || cp .env.example .env",
  "customizations": {
    "vscode": {
      "settings": {
        "terminal.integrated.defaultProfile.linux": "bash"
      }
    }
  },
  "remoteUser": "node"
}
