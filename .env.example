# Required for Mom + Bestie chat
OPENROUTER_API_KEY=

# Stable default; OpenRouter chooses an appropriate model.
OPENROUTER_MODEL=openrouter/auto

# Backend server
PORT=8787
HOST=0.0.0.0

# Optional. Recommended when you expose the backend on a public Codespaces URL
# or deploy it to another machine. Put the same value in the extension Options page.
APP_SHARED_SECRET=

# Optional OpenRouter attribution headers
APP_URL=http://localhost:8787
APP_TITLE=CartSide Blitz
